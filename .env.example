# Weft — local configuration
# This file is gitignored. Never commit it, and don't paste its contents into chat.

# ── Google OAuth · Gmail, read-only ──────────────────────────────────────────
# APIs & Services → Credentials → Create credentials → OAuth client ID
#   Application type: Web application
#   Authorized redirect URI: must match GOOGLE_REDIRECT_URI below exactly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/oauth/callback

# The only scope Weft requests. Read-only: it cannot label, send, or delete.
# The account's own address comes from users.getProfile, so no extra scope.
GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.readonly

# ── Vertex AI · Gemini ───────────────────────────────────────────────────────
# Vertex bills the Cloud project, so that project's credits apply. No API key.
# One-time setup:
#   gcloud services enable aiplatform.googleapis.com --project=YOUR_PROJECT_ID
#   gcloud auth application-default login
# ADC keeps credentials in your gcloud config — nothing secret lands in this repo.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Only if you prefer a service account over ADC. Leave commented to use ADC.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Models. Verified reachable on the `global` endpoint for this project.
# Thinking is set via generationConfig.thinkingConfig.thinkingLevel — note the
# nesting; thinkingLevel at the top of generationConfig is rejected by Vertex v1.
#
# Extractor runs on every message, so it must stay cheap.
# 3.5-flash-lite defaults to no thinking: 0 thought tokens, ~700ms.
# DO NOT raise this to "low" — measured at 1058 thought tokens, 17x the cost.
GEMINI_EXTRACT_MODEL=gemini-3.5-flash-lite
GEMINI_EXTRACT_THINKING=minimal

# Composer runs once per edition, so thinking is worth paying for.
# 3.7-flash supports low|medium|high only — "minimal" is rejected by the API.
GEMINI_COMPOSE_MODEL=gemini-3.7-flash
GEMINI_COMPOSE_THINKING=medium

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8787

# ── Local data ───────────────────────────────────────────────────────────────
# SQLite file holding cached mail, extractions, and OAuth tokens. Gitignored.
DATABASE_URL=./data/weft.db

# Days of history pulled on the first sync of each account.
BACKFILL_DAYS=30
